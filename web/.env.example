CITYCYCLE_OPENAI_KEY=your-key-here
# or CITYCYCLE_OPENAI_KEY (takes priority; use it if a system-wide OPENAI_API_KEY exists)
# OPENAI_MODEL=gpt-4o-mini
# Truck log (Supabase). The publishable key is server-side only: never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional but recommended on a public deployment: drivers must type this code to log bikes.
# CREW_ACCESS_CODE=choose-a-code
